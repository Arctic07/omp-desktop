{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omp Desktop",
  "version": "0.2.0",
  "identifier": "com.omp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter src dev",
    "beforeBuildCommand": "pnpm --filter src build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omp Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true,
        "resizable": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "frame-ancestors 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' http://omp-renderer.localhost omp-renderer:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Stencil Labs",
    "copyright": "Copyright © Stencil Labs",
    "homepage": "https://omp.auiox.com",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../src/src/fonts/misans/LICENSE": "MiSans-LICENSE.txt",
      "binaries/bundle": "bundle",
      "resources/plugin-templates": "plugin-templates",
      "resources/builtin-browser-marketplace": "builtin-browser-marketplace"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2ODVCOEZCQzU5NTNGNDIKUldSQ1A1WEYrN2lGWmphY2dITDdCSFRSd1FnakJuV1B4cnhwQUUzNkMzQjE4SWVFTHZ3NU5mbDUK",
      "endpoints": [
        "https://github.com/Arctic07/omp-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
