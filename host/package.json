{
  "name": "omp-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-owned SDK host for OMP Desktop (form B): one process, many sessions, NDJSON over stdio.",
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun run build.ts",
    "install:bin": "bun run build.ts --install",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "seam:check": "bun run scripts/seam-check.ts",
    "smoke": "bun run scripts/smoke.ts",
    "isolation": "bun run scripts/isolation.ts",
    "artifacts": "bun run scripts/artifacts.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.16.0",
    "@oh-my-pi/pi-ai": "18.16.0",
    "@oh-my-pi/pi-utils": "18.16.0"
  }
}
